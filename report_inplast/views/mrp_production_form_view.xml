<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the MRP Production form view to add our button -->
    <record id="view_mrp_production_form_inherit_box_label" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.box.label</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_label_type']" position="after">
                <button string="Box Label" type="object" name="action_open_box_label"/>
            </xpath>
        </field>
    </record>
</odoo>
<odoo>
    <record id="inplast_external_layout_custom" model="ir.ui.view">
        <field name="name">inplast.external.layout.custom</field>
        <field name="inherit_id" ref="web.external_layout_standard"/>
        <field name="arch" type="xml">
            <!-- 1. Ocultamos el header original agregándole la clase "d-none" -->
            <xpath expr="//div[@t-attf-class='header o_company_#{company.id}_layout']" position="attributes">
                <attribute name="t-if">1 == 0</attribute>
            </xpath>

            <!-- 2. Insertamos el header personalizado en el padre del header original -->
            <xpath expr="//div[@t-attf-class='header o_company_#{company.id}_layout']/.." position="inside">
                <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                    <div class="row">
                        <div class="col-8">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 style="max-height: 150px;" alt="Logo"/>
                        </div>
                        <div class="col-3">
                            <img t-if="company.pnt_logo_cert_uno" t-att-src="image_data_uri(company.pnt_logo_cert_uno)"
                                 style="max-height: 120px;" alt="Company logo2"/>
                        </div>
                        <div class="col-3">
                            <img t-if="company.pnt_logo_cert_dos" t-att-src="image_data_uri(company.pnt_logo_cert_dos)"
                                 style="max-height: 120px;" alt="Company logo"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

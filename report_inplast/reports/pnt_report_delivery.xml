<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- =============================================================================
             TEMPLATE: Documento de Entrega Personalizado
             ============================================================================= -->
        <template id="pnt_report_delivery_document" name="Custom Delivery Document">
            <t t-name="pnt_report_delivery_document">
                <t t-call="web.html_container">
                    <t t-call="stock.report_delivery_document"/>
                </t>
            </t>
        </template>

        <!-- =============================================================================
             TEMPLATE: Adjuntos Personalizados para la Entrega (COA)
             ============================================================================= -->
        <template id="pnt_report_delivery_attachments" name="Custom attachments Document">
            <t t-name="pnt_report_delivery_attachments">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.html_container">
                        <!-- Se itera por cada lote siempre y cuando existan líneas de movimiento asociadas al lote
                             y el partner tenga configurado el COA en el reporte de picking -->
                        <t t-if="o and o.get_move_lines_by_parent_lot() and o.partner_id.pnt_picking_report_id.coa">
                            <t t-foreach="o.get_move_lines_by_parent_lot()" t-as="line">
                                <t t-if="o.partner_id.pnt_picking_report_id.coa">
                                    <t t-if="line.product_id.pnt_product_coa">


                                        <t
                                                t-if="line.product_id.pnt_product_coa.type == 'normal' or line.product_id.pnt_product_coa.type == 'buxton'"
                                                t-call="report_inplast.coa_product_document_a" t-lang="o._get_report_lang()"
                                        />

                                        <!-- COA para tipo 'nmp' -->
                                        <t
                                                t-if="line.product_id.pnt_product_coa.type == 'nmp'"
                                                t-call="report_inplast.coa_product_nmp_document" t-lang="o._get_report_lang()"
                                        />
                                        <!-- COA para tipo 'asas' -->
                                        <t
                                                t-if="line.product_id.pnt_product_coa.type == 'asas'"
                                                t-call="report_inplast.coa_product_handle_document" t-lang="o._get_report_lang()"
                                        />
                                        <!-- Para 'buxton' se añade el certificado por lote, si está configurado -->
                                        <t t-if="line.product_id.pnt_product_coa.type == 'buxton'">
                                            <t
                                                    t-if="o.partner_id.pnt_picking_report_id.coa_batch_certificate"
                                                    t-call="report_inplast.coa_product_batch_certificate_document" t-lang="o._get_report_lang()"
                                            />
                                        </t>
                                        <!-- Adjuntos multicolor -->
                                        <t
                                                t-if="o.partner_id.pnt_picking_report_id.coa_multicolor and line.product_id.pnt_product_coa.get_multicolor_body_for_partner_lang(o.partner_id.lang)"
                                                t-call="report_inplast.coa_product_document_multicolor_attachment" t-lang="o._get_report_lang()"
                                        />
                                        <!-- Adjuntos de medidas de calidad (milk) -->
                                        <t
                                                t-if="o.partner_id.pnt_picking_report_id.coa_milk and line.product_id.pnt_product_coa.print_quality_meassure"
                                                t-call="report_inplast.coa_product_document_meassures_attachment" t-lang="o._get_report_lang()"
                                        />
                                        <!-- Adjuntos de componentes -->
                                        <t
                                                t-if="line.product_id.pnt_product_coa.print_components"
                                                t-call="report_inplast.coa_product_document_attachment" t-lang="o._get_report_lang()"
                                        />
                                        <!-- NOTA: Falta incluir el reporte de seguimiento de cajas si se requiere -->
                                    </t>
                                </t>
                            </t>
                        </t>
                        <!-- Si no se cumplen las condiciones, se muestra un mensaje de error -->
                        <t t-else="">
                            <t t-call="report_inplast.coa_error"/>
                        </t>
                        <!-- Opción de impresión de packing list (comentada por defecto)
                        <t t-if="o.carrier_id.pnt_print_picking_list" t-call="report_inplast.packing_list"/>
                        -->
                    </t>
                </t>
            </t>
        </template>

        <!-- =============================================================================
             EXTENSIÓN: Líneas con números de serie en el reporte de entrega
             Se hereda la vista stock_report_delivery_has_serial_move_line para incluir
             cálculos personalizados de unidades y cajas.
             ============================================================================= -->

        <template id="report_delivery_has_serial_move_line_inh"
                  inherit_id="stock.stock_report_delivery_has_serial_move_line" priority="99">
            <!-- Inserción de nuevas celdas en la línea del reporte -->
            <xpath expr="//t[@t-name='stock.stock_report_delivery_has_serial_move_line']" position="inside">
                <td class="text-center">
                    <span>(</span>
                    <span t-esc="move_line.quantity_done_by_lot * o.product_id.pnt_box_qty"/>
                    <!-- <span t-esc="o.get_quantity_done_lot * o.product_id.pnt_box_qty"/> -->
                    <span>X</span>
                    <span t-esc="o.product_id.pnt_parent_qty / o.product_id.pnt_box_qty"/>
                    <span>Units / Box</span>
                    <span>)</span>
                </td>
                <td class="text-center">
                    <span t-esc="move_line.quantity_done_by_lot * o.product_id.pnt_parent_qty"/>
                </td>
                <td class="text-center">
                    <span t-esc="o.product_id.pnt_parent_qty"/>
                </td>
                <t t-set="matching_code"
                   t-value="[code for code in o.product_id.pnt_parent_id.pnt_customer_code_ids if code.partner_id == o.partner_id.commercial_partner_id]"/>
                <t t-if="not matching_code">
                    <span style="font-weight:bold; font-size:30px;"
                          t-field="o.product_id.default_code"></span>
                </t>
                <t t-if="matching_code and matching_code[0].name">
                    <td class="text-center">
                        <span t-esc="matching_code[0].name"/>
                    </td>
                </t>
                <t t-if="matching_code and matching_code[0].gtin">
                    <td class="text-center">
                        <span t-esc="matching_code[0].gtin"/>
                    </td>
                </t>
            </xpath>

            <!-- Reemplazo del contenido de 'move_line_lot' si existe número de serie -->
            <xpath expr="//t[@name='move_line_lot']" position="attributes">
                <attribute name="t-if">1 == 0</attribute>
            </xpath>
            <xpath expr="//t[@name='move_line_lot']" position="after">
                <t t-if="has_serial_number" name="move_line_lot">
                    <td>
                        <span t-field="move_line.lot_id.parent_id.name"/>
                    </td>
                </t>
            </xpath>

            <!-- Reemplazo de la cantidad mostrada por línea de lote -->
            <xpath expr="///td[@name='move_line_lot_quantity']/span[@t-field='move_line.quantity']"
                   position="attributes">
                <attribute name="t-if">1 == 0</attribute>
            </xpath>
            <xpath expr="///td[@name='move_line_lot_quantity']/span[@t-field='move_line.quantity']" position="after">
                <span t-field="move_line.quantity_done_by_lot"/>
            </xpath>
        </template>

        <!-- =============================================================================
             RECORD: Vista de Adjuntos del Picking (extiende report_delivery_document)
             Se incluyen nuevos encabezados, cálculos totales y ajustes en la vista.
             ============================================================================= -->
        <record id="inplast_report_picking_attachments" model="ir.ui.view">
            <field name="name">inplast.report.picking.attachments</field>
            <field name="inherit_id" ref="stock.report_delivery_document"/>
            <field name="arch" type="xml">
                <!-- Reemplazo de la sección del tbody para líneas con número de serie -->
                <xpath expr="//table[@class='table table-sm mt48']/tbody/t[@t-else='']/t" position="replace">
                    <t t-if="has_serial_number">
                        <tr t-foreach="o.get_move_lines_by_parent_lot()" t-as="move_line">
                            <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                        </tr>
                    </t>
                </xpath>

                <!-- Inserción de nuevos encabezados en la tabla -->
                <xpath expr="//table[@name='stock_move_line_table']/thead/tr" position="inside">
                    <th class="text-center">
                        <strong>Box/Units</strong>
                    </th>
                    <th class="text-center">
                        <strong>Units</strong>
                    </th>
                    <th class="text-center">
                        <strong>Units x package</strong>
                    </th>
                    <th class="text-center">
                        <strong>REF</strong>
                    </th>
                    <th class="text-center">
                        <strong>GTIN</strong>
                    </th>
                </xpath>


                <!-- Sección previa a la firma: imagen, totales y datos adicionales -->
                <xpath expr="//div[@t-if='not o.signature']" position="before">
                    <!-- Imagen de la empresa -->
                    <div style="width: 100%; page-break-inside: avoid; text-align: center; height: 600px;">
                        <t t-set="company" t-value="o.company_id"/>
                        <img style="margin-top:10px; width: 100%; page-break-inside: avoid; text-align: center; max-height: 600px;"
                             t-if="company.pnt_goods_state_table"
                             t-att-src="image_data_uri(company.pnt_goods_state_table)"
                             alt="Company Image"/>
                    </div>

                    <!-- Variables para el cálculo de totales -->
                    <t t-set="lines" t-value="o.move_ids"/>
                    <t t-set="total_quantity" t-value="sum(line.quantity for line in lines)"/>
                    <t t-set="total_quantity_box"
                       t-value="sum((line.product_id.pnt_box_qty) * line.quantity for line in lines)"/>

                    <!-- Sección de totales y datos de envío -->
                    <div style="page-break-inside: avoid;">
                        <div style="margin-top: 20px;">
                            <strong>Total packages:</strong>
                            <span t-esc="total_quantity"/>
                            <br/>
                            <strong style="margin-top: 5px;">Total boxes:</strong>
                            <span t-esc="total_quantity_box"/>
                            <br/>
                            <strong style="margin-top: 5px;">Total net weight:</strong>
                            <span t-esc="o.weight"/>
                            <br/>
                            <strong style="margin-top: 5px;">Total gross weight:</strong>
                            <span t-esc="o.shipping_weight"/>
                            <br/>
                        </div>

                        <!-- Datos del pedido y transportista -->
                        <div class="row" style="margin-top: 20px;">
                            <div class="col-4">
                                <strong style="border: 2px solid #000; padding: 5px; text-align: left; background-color:#D3D3D3;">
                                    Order No.:
                                </strong>
                                <span style="margin-left: 5px" t-field="o.sale_id.client_order_ref"/>
                            </div>
                            <div class="col-offset-8 col-4">
                                <strong style="border: 2px solid #000; padding: 5px; text-align: left; background-color:#D3D3D3;">
                                    Transport Agency:
                                </strong>
                                <span style="margin-left: 5px" t-field="o.carrier_id"/>
                            </div>
                            <div class="col-offset-16 col-4">
                                <strong style="border: 2px solid #000; padding: 5px; text-align: left; background-color:#D3D3D3;">
                                    Date:
                                </strong>
                                <span style="margin-left: 5px" t-esc="o.date" t-if="o.date"/>
                            </div>
                        </div>

                        <!-- Sección de comentarios y nota legal -->
                        <div style="font-size: 14px;">
                            <div class="row" style="margin-top: 15px; margin-bottom: 20px;">
                                <div class="col-6">
                                    <!-- Se puede activar información adicional del transportista (comentada) -->
                                    <!--
                                    <t t-if="o.carrier_id.pnt_agency_or_carrier">
                                      <strong>Transport Agent</strong>
                                      <span t-field="o.carrier_id"/>
                                      <br/>
                                    </t>
                                    <t t-if="o.carrier_id.pnt_address">
                                      <strong>Address</strong>
                                      <span t-field="o.carrier_id.pnt_address"/>
                                      <br/>
                                    </t>
                                    <t t-if="o.carrier_id.pnt_cif">
                                      <strong>CIF</strong>
                                      <span t-field="o.carrier_id.pnt_cif"/>
                                      <br/>
                                    </t>
                                    -->
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <strong style="margin-top: 5px;">Comments</strong>
                                        <br/>
                                    </div>
                                </div>
                            </div>
                            <div style="margin-top: 15px;">
                                <p>
                                    The final holder of used packaging waste must deliver it in appropriate conditions
                                    for separation
                                    by materials to an ecological agent for reuse to a collector, recycler, or
                                    authorized valorizer.
                                    Registered in the Commercial Registry of Alicante: Volume 1,712 General, Folio 11.
                                    Sheet no. A-27.348.
                                    Registration 1st, 14-6-1994 - C.I.F. A-03946472
                                </p>
                            </div>
                        </div>
                    </div>
                </xpath>

                <!-- =============================================================================
                     Sección de dirección y datos del cliente
                     ============================================================================= -->
                <xpath expr="//t[@t-set='address']" position="replace">
                    <div style="height:30px;"></div>
                    <div class="row">
                        <div class="col-6">
                            <!-- Espacio para dirección o logo -->
                        </div>
                        <div class="col-offset-6 col-6">
                            <strong t-field="o.name">WH/OUT/0001</strong>
                        </div>
                    </div>
                    <div class="row justify-content-center align-items-center">
                        <div class="col-6 text-center"
                             style="border: 1px solid #000; height: 30px; background-color:#D3D3D3;">
                            <strong style="width: 100%;">Customer</strong>
                        </div>
                        <div class="col-offset-6 col-6 text-center"
                             style="border: 1px solid #000; height: 30px; background-color:#D3D3D3; margin-left: 3px;">
                            <strong>Square</strong>
                        </div>
                    </div>
                    <div class="row gx-2">
                        <div class="col-5 col-auto">
                            <strong t-field="o.partner_id"/>
                        </div>
                        <div class="col-2 col-auto">
                            <span t-field="o.partner_id.phone"/>
                        </div>
                        <div class="col-5 col-auto">
                            <span t-field="o.partner_id.street" style="margin-left: 15px;"/>
                            <span t-field="o.partner_id.zip"/>
                        </div>
                        <div class="col-2 col-auto">
                            <span t-field="o.partner_id.state_id.name"/>
                        </div>
                    </div>
                </xpath>

                <!-- Eliminamos encabezados o filas innecesarias -->
                <xpath expr="//div[@class='page']/h2/span[@t-field='o.name']" position="replace"/>
                <xpath expr="//div[contains(@class, 'row') and contains(@class, 'mt32') and contains(@class, 'mb32')]"
                       position="replace"/>
            </field>
            <field name="priority">99</field>
        </record>

    </data>
</odoo>

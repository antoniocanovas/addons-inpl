<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_client_order_ref_form_view" model="ir.ui.view">
        <field name="name">sale.order.client.order.ref.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <xpath
                expr="//field[@name='order_line']/form//field[@name='tax_id']"
                position="after"
            >
                <field name="client_order_ref" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='price_unit']"
                position="after"
            >
                <field name="client_order_ref" optional="show" />
            </xpath>
        </field>
    </record>y

</odoo>

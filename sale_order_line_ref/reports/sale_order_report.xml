<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//table/thead//tr[1]//th[1]" position="after">
            <th t-if="any(line.client_order_ref for line in doc.order_line)" class="text-left">Ref</th>
        </xpath>
        <xpath
            expr="//table/tbody[hasclass('sale_tbody')]//tr[1]//td[1]"
            position="after"
        >
            <td t-if="any(line.client_order_ref for line in doc.order_line)">
                <span t-field="line.client_order_ref" />
            </td>
        </xpath>
    </template>
</odoo>

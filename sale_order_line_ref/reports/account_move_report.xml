<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//table/thead//tr[1]//th[1]" position="after">
            <th t-if="any(line.client_order_ref for line in o.invoice_line_ids)" class="text-left">Ref</th>
        </xpath>
        <xpath
            expr="//table/tbody[hasclass('invoice_tbody')]//tr[1]//td[1]"
            position="after"
        >
            <td t-if="any(line.client_order_ref for line in o.invoice_line_ids)">
                <span t-field="line.client_order_ref" />
            </td>
        </xpath>
    </template>
</odoo>

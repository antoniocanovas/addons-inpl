<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    # container_types per partner:
    <record id="logistic_inplast_res_partner_form" model="ir.ui.view">
        <field name="name">logistic.inplast.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='property_product_pricelist']" position="after">
                    <field name="container_type_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </tree>
                    </field>
                </xpath>

            </data>
        </field>
        <field name="priority">99</field>
        <field name="type">form</field>
    </record>

</odoo>
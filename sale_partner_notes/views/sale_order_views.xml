<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_client_notes" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.notes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Client Notes" name="action_open_client_notes" type="object" class="btn btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
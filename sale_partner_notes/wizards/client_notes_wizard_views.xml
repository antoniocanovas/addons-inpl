<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_client_notes_wizard_form" model="ir.ui.view">
        <field name="name">client.notes.wizard.form</field>
        <field name="model">client.notes.wizard</field>
        <field name="arch" type="xml">
            <form string="Client Notes">
                <sheet>
                    <field name="sale_id" invisible="1"/>
                    <group string="Customer Information">
                        <field name="partner_id" string="Partner"/>
                        <field name="partner_note" placeholder="No notes available" invisible="partner_note == False"
                               string="Note"/>
                        <field name="partner_sale_warn" invisible="partner_sale_warn == False" string="Sale warn"/>
                        <field name="partner_sale_warn_msg" invisible="partner_sale_warn_msg == False" string="Warm"/>
                    </group>
                    <group string="Commercial Entity Information" invisible="partner_id == commercial_partner_id ">
                        <field name="commercial_partner_id" string="Partner"/>
                        <field name="commercial_partner_note" placeholder="No notes available"
                               invisible="commercial_partner_note == False" string="Note"/>
                        <field name="commercial_partner_sale_warn" invisible="commercial_partner_sale_warn == False"
                               string="Sale warn"/>
                        <field name="commercial_partner_sale_warn_msg"
                               invisible="commercial_partner_sale_warn_msg == False" string="Warm"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Accept" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_client_notes_wizard" model="ir.actions.act_window">
        <field name="name">Client Notes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">client.notes.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>